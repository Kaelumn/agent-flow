{
  "name": "@agent-flow/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -b",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "test": "vitest run",
    "db:migrate": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/migrate.ts",
    "db:seed": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/seed.ts"
  },
  "dependencies": {
    "@agent-flow/core": "0.1.0",
    "@fastify/static": "^8.2.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "fastify": "^5.6.0",
    "kysely": "^0.28.0",
    "mysql2": "^3.15.0",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
