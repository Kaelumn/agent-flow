# Server
PORT=3100
LOG_LEVEL=info

# Database: mysql now, postgres later (same migrations). Create the database first.
DB_DIALECT=mysql
DATABASE_URL=mysql://user:password@127.0.0.1:3306/agent_flow
# DB_DIALECT=postgres
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/agent_flow

# Bearer tokens: token:workspace:actor, comma separated. Give agents and people separate tokens.
AUTH_TOKENS=change-me-web:default:admin,change-me-agent:default:agent

# Tool catalog from live MCP servers (path relative to apps/server), e.g. the mock tenant:
# TOOL_SERVERS_CONFIG=../mock-msp/catalog-servers.json
# Otherwise a static file: TOOL_CATALOG_PATH=/path/to/tool-catalog.json

# Web app address, so the agent can link people to the canvas
# PUBLIC_WEB_URL=https://flows.example.com

# Pages allowed to embed the canvas and receive annotations (comma-separated origins)
# EMBED_ORIGINS=https://app.mspbots.ai
